{
  "manifest_version": 3,
  "name": "Gemini Image Transcriber",
  "version": "1.0.0",
  "description": "Batch verbatim OCR of image folders using gemini.google.com, with a local file bridge.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Gemini Image Transcriber"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/gemini-automator.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
